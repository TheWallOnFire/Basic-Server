-- Redis Commands Example
-- You can run these commands in the redis-cli

-- 1. Strings (Basic Key-Value)
SET user:1000 "JohnDoe"
GET user:1000
DEL user:1000

-- 2. Hashes (Storing Objects)
HSET student:1 name "Alice" age "22" major "Computer Science"
HGET student:1 name
HGETALL student:1

-- 3. Lists (Queues / Stacks)
LPUSH task_queue "task_A"
LPUSH task_queue "task_B"
LRANGE task_queue 0 -1  -- View all items
RPOP task_queue         -- Remove and get the last item (task_A)

-- 4. Sets (Unique Collections)
SADD active_users "user1" "user2" "user3"
SADD active_users "user1" -- Ignored, already exists
SMEMBERS active_users
SISMEMBER active_users "user2" -- Returns 1 (true)

-- 5. Sorted Sets (Leaderboards, Priority Queues)
ZADD leaderboard 100 "PlayerA"
ZADD leaderboard 250 "PlayerB"
ZADD leaderboard 50 "PlayerC"
ZRANGE leaderboard 0 -1 WITHSCORES -- Ascending
ZREVRANGE leaderboard 0 -1 WITHSCORES -- Descending

-- 6. Expiration (TTL)
SET session:token "abc123xyz" EX 3600 -- Expires in 1 hour
TTL session:token -- Check remaining time to live
